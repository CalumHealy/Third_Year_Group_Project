<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings</title>
    <link rel="stylesheet" href="css/main.css"><!--Linking to css file-->
</head>
<body>
    <div class="wrapper">
        <div class="sidebar"> <!-- sidebar for the links to other pages-->
            <h2>ACT-Web</h2>
            <ul>
                <li><a href="/home">My Invest</a></li>
                <li><a href="/buystock">Stock Invest</a></li>
                <li><a href="/buycrypto">Crypto Invest</a></li>
                <li><a href="/help">Help</a></li>
                <li><a href="/settings">My Account</a></li>
                <li><a href="/review">Reviews</a></li>
            </ul>    
        </div>
        <div class="main">
            <div class="titlebar">My Account</div> <!-- Title bar to show the title neatly-->
            <div class="manager">
                <p>Signed In As: </p>
                <div>Manager: <%= username %></div>
                <br>
                <div>Company: <%= companyName %></div>
            </div>
            <br>
            <div class="account">
                <p>Account: $ <%= balance %></p>
                <div class="button-container">
                    <a href="/add_funds" class="button">Add</a>
                    <a href="/upgrade" class="button">Upgrade</a>
                </div>
            </div>
            <br>
            <div class="held">
                <p># Stocks Held: <%= stockAmount %>/10<!--Data Will be Pulled from FB DB --></p>
                <br>
                <p># Crypto Held: 0/3<!--Data Will be Pulled from FB DB --></p>
            </div>
            <div class="switch">
                <a href="/select_company" class="button">Switch Company</a>
            </div>
    </div>
</body>
</html>