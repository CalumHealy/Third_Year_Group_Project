<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Screen</title>
    <link rel="stylesheet" href="css/main.css"><!--Linking to css file-->
    <script>
        // Function to show alert if price change exceeds 5%
        function checkPriceChange(change) {
            if (Math.abs(change) >= 5) {
                alert("Price change exceeds 5%! " + (change > 0 ? "Positive" : "Negative") + " change: " + change.toFixed(2) + "%");
            }
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
    <div class="wrapper">
        <div class="sidebar"> <!-- sidebar for the links to other pages-->
            <h2>ACT-Web</h2>
            <ul>
                <li><a href="/home">My Invest</a></li>
                <li><a href="/buystock">Stock Invest</a></li>
                <li><a href="/buycrypto">Crypto Invest</a></li>
                <li><a href="/help">Help</a></li>
                <li><a href="/settings">My Account</a></li>
                <li><a href="/review">Reviews</a></li>
            </ul>    
        </div>
        <div class="main">
            <div class="titlebar">Home</div> <!-- Title bar to show the title neatly-->
            <div class="header"><h1>Welcome manager <%= username %>!</h1><br>This is the landing screen for after login.</div>
            <div class="info">
                <p>Gives an overview of your owned stocks and cryptos.</p>
                <h2>Stocks</h2>
                <div class="home-container">
                    <% LiveStock.forEach(stock => { 
                        const priceChange = ((stock.currentPrice - stock.price) / stock.price) * 100;
                        const chartId = 'chart-' + stock.name.replace(/\s+/g, '_').toLowerCase();
                        %>
                        <div class="home">
                            <div class="data">
                                <p><strong>Name: </strong><%= stock.name %></p>
                                <p><strong>Bought Price: </strong>$<%= stock.price %></p>
                                <p><strong>Current Price: </strong>$ <%= stock.currentPrice %></p>
                                <p><strong>Change: </strong><%= priceChange.toFixed(2) %>%</p>
                                <p><strong>Quantity: </strong><%= stock.quantity %></p>
                                <div class="profit <%= stock.profitLoss >= 0 ? 'profit-positive' : 'profit-negative' %>">
                                    <p><strong>Profit/Loss: </strong>$ <%= stock.profitLoss.toFixed(2) %></p>
                                </div>
                                <a href="/sell_stock/<%= stock.name %>">Sell </a>
                                </div>
                            <div class="rec-row">
                                <p><strong>AI Recommendation: </strong><br>AI Recommendation goes here</p>
                            </div>
                            <div class="chart-row">
                                <canvas id="chart-<%= stock.name.replace(/\s+/g, '_').toLowerCase()%>" width="400" height="200"></canvas>
                            </div>
                        </div>
                        <script>
                            document.addEventListener('DOMContentLoaded', function() {
                                checkPriceChange(<%= priceChange %>);
                                // data for chart
                                let stockData = {
                                    labels: ['Bought Price', 'Current Price'],
                                    datasets: [{
                                        label: 'Stock Price ($)',
                                        data: [<%= stock.price %>, <%= stock.currentPrice %>],
                                        borderColor: 'rgba(75, 192, 192, 1)', 
                                        backgroundColor: 'rgba(75, 192, 192, 0.2)', 
                                        borderWidth: 2,
                                        tension: 0.4, 
                                        fill: false 
                                    }]
                                };
                                // Chart.js configuration
                                const ctx = document.getElementById('chart-<%= stock.name.replace(/\s+/g, "_").toLowerCase()%>').getContext('2d');
                                if (ctx){
                                    const myChart = new Chart(ctx, {
                                    type: 'line',
                                    data: stockData,
                                    options: {
                                        responsive: true,
                                        scales: {
                                            y: {
                                                beginAtZero: false
                                            }
                                        }
                                    }
                                });
                                }else{
                                    console.error("Canvas element not found for stock chart ID: <%= chartId %>");
                                }
                            });
                        </script>
                    <% }); %>
                </div>
                <h2>Crypto</h2>
                <div class="home-container">
                    <% LiveCrypto.forEach(crypto => { 
                        const priceChange = ((crypto.currentPrice - crypto.price) / crypto.price) * 100;
                        const chartId = 'chart-' + crypto.name.replace(/\s+/g, '_').toLowerCase();
                        %>
                        <div class="home">
                            <div class="data">
                                <p><strong>Name: </strong><%= crypto.name %></p>
                                <p><strong>Bought Price: </strong>$<%= crypto.price %></p>
                                <p><strong>Current Price: </strong>$<%= crypto.currentPrice %></p>
                                <p><strong>Change: </strong><%= priceChange.toFixed(2) %>%</p>
                                <p><strong>Quantity: </strong><%= crypto.quantity %></p>
                                <div class="profit <%= crypto.profitLoss >= 0 ? 'profit-positive' : 'profit-negative' %>">
                                    <p><strong>Profit/Loss: </strong>$ <%= crypto.profitLoss.toFixed(2) %></p>
                                </div>
                                <a href="/sell_crypto/<%= crypto.id %>">Sell</a>
                            </div>
                            <div class="rec-row">
                                <p><strong>AI Recommendation: </strong><br>AI Recommendation goes here</p>
                            </div>
                            <div class="chart-row">
                                <canvas id="chart-<%= crypto.name.replace(/\s+/g, '_').toLowerCase()%>" width="400" height="200"></canvas>
                            </div>
                        </div>
                        <script>
                                document.addEventListener('DOMContentLoaded', function() {
                                    checkPriceChange(<%= priceChange %>);
                                    // data for chart
                                    let cryptoData = {
                                            labels: ['Bought Price', 'Current Price'],
                                            datasets: [{
                                                label: 'Crypto Price ($)',
                                                data: [<%= crypto.price %>, <%= crypto.currentPrice %>],
                                                borderColor: 'rgba(75, 192, 192, 1)', 
                                                backgroundColor: 'rgba(75, 192, 192, 0.2)', 
                                                borderWidth: 2,
                                                tension: 0.4, 
                                                fill: false 
                                            }]
                                    };
                                        // Chart.js configuration
                                        const ctx = document.getElementById('chart-<%= crypto.name.replace(/\s+/g, "_").toLowerCase()%>').getContext('2d');
                                        if (ctx){
                                            const myChart = new Chart(ctx, {
                                            type: 'line',
                                            data: cryptoData,
                                            options: {
                                                responsive: true,
                                                scales: {
                                                    y: {
                                                        beginAtZero: false
                                                    }
                                                }
                                            }
                                        });
                                        }else{
                                            console.error("Canvas element not found for crypto chart ID: <%= chartId %>");
                                        }
                                    });
                        </script>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</body>
</html>