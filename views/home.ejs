<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Screen</title>
    <link rel="stylesheet" href="css/main.css"><!--Linking to css file-->
</head>
<body>
    <div class="wrapper">
        <div class="sidebar"> <!-- sidebar for the links to other pages-->
            <h2>ACT-Web</h2>
            <ul>
                <li><a href="/home">My Invest</a></li>
                <li><a href="/buystock">Stock Invest</a></li>
                <li><a href="/buycrypto">Crypto Invest</a></li>
                <li><a href="/help">Help</a></li>
                <li><a href="/settings">My Account</a></li>
                <li><a href="/review">Reviews</a></li>
            </ul>    
        </div>
        <div class="main">
            <div class="titlebar">Home</div> <!-- Title bar to show the title neatly-->
            <div class="header">Welcome manager <%= username %>!<br>This is the landing screen for after login.</div>
            <div class="info">
                <div>Gives an overview of your owned stocks and cryptos.</div>
                <h2>Stocks</h2>
                <div class="home-container">
                    <% stocks.forEach(stock => { %>
                        <div class="home">
                            <div class="data">
                                <p><strong>Name: </strong><%= stock.name %></p>
                                <p><strong>Bought Price: </strong>$<%= stock.price %></p>
                                <p><strong>Current Price: </strong>$ (api call)</p>
                                <p><strong>Change: </strong>%</p>
                                <p><strong>Quantity: </strong><%= stock.quantity %></p>
                                <p><strong>Profit/Loss: </strong>$</p>
                                <a href="/sell_confirm/<%= stock.name %>">Sell </a>
                                </div>
                            <div class="rec-row">
                                <p><strong>AI Recommendation: </strong><br>AI Recommendation goes here</p>
                            </div>
                            <div class="chart-row">
                                <p>Chart will go here <br>chart js</p>
                            </div>
                        </div>
                    <% }); %>
                </div>
                <h2>Crypto</h2>
                <div class="home-container">
                    <% cryptos.forEach(crypto => { %>
                        <div class="home">
                            <div class="data">
                                <p><strong>Name: </strong><%= crypto.name %></p>
                                <p><strong>Bought Price: </strong>$<%= crypto.price %></p>
                                <p><strong>Current Price: </strong>$ (api call)</p>
                                <p><strong>Change: </strong>%</p>
                                <p><strong>Quantity: </strong><%= crypto.quantity %></p>
                                <p><strong>Profit/Loss: </strong>$</p>
                                <a href="/sell_confirm/<%= crypto.name %>">Sell</a>
                            </div>
                            <div class="rec-row">
                                <p><strong>AI Recommendation: </strong><br>AI Recommendation goes here</p>
                            </div>
                            <div class="chart-row">
                                <p>Chart will go here <br>chart js</p>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>
    </div>
</body>
</html>