<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stock Buy</title>
    <link rel="stylesheet" href="css/main.css"><!--Linking to css file-->
</head>
<body>
    <div class="wrapper">
        <div class="sidebar"> <!-- sidebar for the links to other pages-->
            <h2>ACT-Web</h2>
            <ul>
                <li><a href="/home">My Invest</a></li>
                <li><a href="/buystock">Stock Invest</a></li>
                <li><a href="/buycrypto">Crypto Invest</a></li>
                <li><a href="/help">Help</a></li>
                <li><a href="/settings">My Account</a></li>
                <li><a href="/review">Reviews</a></li>
            </ul>    
        </div>
        <div class="main">
            <div class="titlebar">Buy Stock</div> <!-- Title bar to show the title neatly-->
            <div class="item-list">
                <h1>Available Stocks</h1>
                <% if (stocks && stocks.length > 0) { %>
                    <ul>
                        <% stocks.forEach(stock => { %>
                            <div class="item">
                                <li>
                                    <strong><%= stock.ticker %></strong> - <%= stock.name %>
                                    <a href="/stock/details/<%= stock.ticker %>" class="button">Details</a>
                                </li>
                            </div>
                        <% }) %>
                    </ul>
                <% } else { %>
                    <p>No stocks available at the moment.</p>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>