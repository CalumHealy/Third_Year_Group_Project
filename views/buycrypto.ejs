<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crypto Buy</title>
    <link rel="stylesheet" href="css/main.css"><!--Linking to css file-->
</head>
<body>
    <div class="wrapper">
        <div class="sidebar"> <!-- sidebar for the links to other pages-->
            <h2>ACT-Web</h2>
            <ul>
                <li><a href="/home">My Invest</a></li>
                <li><a href="/buystock">Stock Invest</a></li>
                <li><a href="/buycrypto">Crypto Invest</a></li>
                <li><a href="/help">Help</a></li>
                <li><a href="/settings">My Account</a></li>
                <li><a href="/review">Reviews</a></li>
            </ul>    
        </div>
        <div class="main">
            <div class="titlebar">Buy Crypto</div> <!-- Title bar to show the title neatly-->
            <div class="header">Welcome!</div>
            <div class="info">
                <div>This is the crypto buy page</div>
            </div>
            <div class="item-list">
                <h1>List of Cryptocurrencies</h1>
                <ul>
                    <% cryptoData.forEach(crypto => { %>
                    <div class="item"> 
                        <li>
                            <strong><%= crypto.name %></strong> - <%= crypto.symbol.toUpperCase() %>: <%= crypto.current_price %> USD
                            <a href="/crypto/details/<%= crypto.id %>"class="button">Details</a>
                        </li>
                    </div>   
                    <% }) %>
                </ul>
            </div>
        </div>
    </div>
</body>
</html>