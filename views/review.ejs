<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Review Screen</title>
    <link rel="stylesheet" href="css/main.css"><!--Linking to css file-->
</head>
<body>
    <div class="wrapper">
        <div class="sidebar"> <!-- sidebar for the links to other pages-->
            <h2>ACT-Web</h2>
            <ul>
                <li><a href="/home">My Invest</a></li>
                <li><a href="/buystock">Stock Invest</a></li>
                <li><a href="/buycrypto">Crypto Invest</a></li>
                <li><a href="/help">Help</a></li>
                <li><a href="/settings">My Account</a></li>
                <li><a href="/review">Reviews</a></li>
            </ul>    
        </div>
        <div class="main">
            <div class="titlebar">Review</div> <!-- Title bar to show the title neatly-->
            <div class="write">
                <p>We would love to hear your thoughts, write your review today!</p>
                <a href="/write_review" class="button">Write</a>
            </div>
            <div class="reviews-list">
                <% if (reviews.length === 0){ %>
                    <p>No reviews found.</p>
                <% } { %>
                    <% reviews.forEach((review) => { %>
                        <div class="review">
                            <h3><%= review.email || "Anonymous" %></h3>
                            <p><strong>Rating: </strong> <%= review.rating || "N/A" %></p>
                            <p><%= review.review %></p>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>