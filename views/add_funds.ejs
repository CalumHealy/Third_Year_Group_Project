<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Funds to Wallet</title>
    <link rel="stylesheet" href="css/paypal.css">
</head>
<body>
    <form id="add_funds">
        <h2>Add Funds to Your Wallet</h2>
        <label for="amount">Enter Amount:</label>
        <input type="number" id="amount" placeholder="Amount to add" min="1" step="0.01" required>
        <div id="paypal-button-container"></div>
        <p id="result-message"></p>
    </form>

    <!-- PayPal SDK script -->
    <script src="https://www.paypal.com/sdk/js?client-id=<%= process.env.PAYPAL_CLIENT_ID %>&components=buttons&enable-funding=paylater,card&disable-funding=venmo"></script>
    <script>
        // Amount input validation
        document.getElementById('amount').addEventListener('input', function() {
            if (this.value <= 0) {
                this.setCustomValidity('Please enter an amount greater than zero.');
            } else {
                this.setCustomValidity('');
            }
        });

        // Render the PayPal button
        paypal.Buttons({
            createOrder: function(data, actions) {
                const amount = document.getElementById('amount').value; // Get the amount from the input field
                return actions.order.create({
                    purchase_units: [{
                        amount: {
                            value: amount // Use the input value for the amount
                        }
                    }]
                });
            },
            onApprove: function(data, actions) {
                return actions.order.capture().then(function(details) {
                    console.log('Transaction completed by ' + details.payer.name.given_name);
                    document.getElementById('result-message').innerText = 'Transaction completed! Amount added: ' + details.purchase_units[0].amount.value + ' USD. Transaction ID: ' + details.id;

                    // Send the transaction details to your server to update the wallet balance
                    fetch('/api/update-wallet', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ 
                            amount: parseFloat(details.purchase_units[0].amount.value) })
                    })
                    .then(response => response.text())
                    .then(message => {
                        console.log(message); // Handle the response from the server
                        document.getElementById('result-message').innerText += '\n' + message;
                    })
                    .catch(error => {
                        console.error('Error updating wallet:', error);
                    });
                });
            },
            onError: function(err) {
                console.error('Error during transaction:', err);
                document.getElementById('result-message').innerText = 'An error occurred. Please try again.';
            }
        }).render('#paypal-button-container'); // Display PayPal button in the specified container
    </script>
</body>
</html>
