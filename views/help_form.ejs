<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Help Form</title>
    <link rel="stylesheet" href="css/main.css"><!--Linking to css file-->
</head>
<body>
    <div class="wrapper">
        <div class="sidebar"> <!-- sidebar for the links to other pages-->
            <h2>ACT-Web</h2>
            <ul>
                <li><a href="/home">My Invest</a></li>
                <li><a href="/buystock">Stock Invest</a></li>
                <li><a href="/buycrypto">Crypto Invest</a></li>
                <li><a href="/help">Help</a></li>
                <li><a href="/settings">My Account</a></li>
                <li><a href="/review">Reviews</a></li>
            </ul>    
        </div>
        <div class="main">
            <div class="titlebar">Help Form</div> <!-- Title bar to show the title neatly-->
            <div class="header">Welcome to the help form!<br> Here you can send queries to our advisors</div>
            <div class="form-container">
                <h2>Contact Us</h2>
                <form action="/help_form" method="POST">
                    <label for="name">Email:</label>
                    <input type="email" id="email" name="email" placeholder="Enter your email" required>
                    <br>
                    <label for="message">Query:</label>
                    <textarea id="message" name="message" placeholder="Enter Your query or question here" required></textarea>
                    <br>
                    <button type="submit" class="button">Submit</button>
                </form>
                <br>
                <a href="/help">Back to Help</a>
            </div>
        </div>
    </div>
</body>
</html>