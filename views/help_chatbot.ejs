<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Help Chatbot</title>
    <link rel="stylesheet" href="css/main.css"><!--Linking to css file-->
    <script>
         // Function to send message
         function sendMessage() {
            const userInput = document.getElementById('user-input').value;
            if (userInput.trim() === '') {
                return; 
            }

            displayMessage(userInput, 'user');

            document.getElementById('user-input').value = '';

            // Send the message to the backend
            fetch('/chat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ message: userInput }),
            })
            .then(response => response.json())
            .then(data => {
                displayMessage(data.reply, 'bot');
            })
            .catch(error => {
                displayMessage("Error communicating with the chatbot. Please try again.", 'bot');
                console.error(error);
            });
        }

        // Function to display messages in the chatbox
        function displayMessage(message, sender) {
            const chatbox = document.getElementById('chatbox');
            const messageElement = document.createElement('div');
            messageElement.classList.add('message');
            messageElement.classList.add(sender); 
            messageElement.textContent = message;
            chatbox.appendChild(messageElement);
            chatbox.scrollTop = chatbox.scrollHeight; 
        }

        document.addEventListener('DOMContentLoaded', function() {
            displayMessage("Hello! How can I help you today?", 'bot');
        });
    </script>
</head>
<body>
    <div class="wrapper">
        <div class="sidebar"> <!-- sidebar for the links to other pages-->
            <h2>ACT-Web</h2>
            <ul>
                <li><a href="/home">My Invest</a></li>
                <li><a href="/buystock">Stock Invest</a></li>
                <li><a href="/buycrypto">Crypto Invest</a></li>
                <li><a href="/help">Help</a></li>
                <li><a href="/settings">My Account</a></li>
                <li><a href="/review">Reviews</a></li>
            </ul>    
        </div>
        <div class="main">
            <div class="titlebar">Help AI Chatbot</div> <!-- Title bar to show the title neatly-->
            <div class="chat-container">
                <div class="chatbox" id="chatbox"></div>
                <input type="text" id="user-input" placeholder="Type your message"/>
                <button onclick="sendMessage()">Send</button>
            </div>
        </div>
    </div>
</body>
</html>