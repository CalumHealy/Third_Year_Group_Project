<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Python-EJS Communication</title>
    <script>
        // Function to send data to the backend
        async function sendData() {
            const userInput = document.getElementById('userInput').value;

            const response = await fetch('/send-data', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ user_input: userInput })
            });

            const result = await response.json();
            document.getElementById('response').textContent = result.response;
        }
    </script>
</head>
<body>
    <h1>Communicate with Python Backend</h1>

    <input type="text" id="userInput" placeholder="Enter text here" />
    <button onclick="sendData()">Send</button>

    <h2>Response:</h2>
    <p id="response"></p>
</body>
</html>
